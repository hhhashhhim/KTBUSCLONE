APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Passenger mobile API. Use IDs from the same company and online terminal.
MOBILE_COMPANY_ID=
MOBILE_TERMINAL_ID=
MOBILE_BOOKING_USER_ID=
MOBILE_MAXIMUM_SELECTABLE_SEATS=5
MOBILE_LATEST_VERSION=1.0.0
MOBILE_MINIMUM_SUPPORTED_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false
MOBILE_MAINTENANCE_MODE=false
MOBILE_MAINTENANCE_MESSAGE=
MOBILE_ANDROID_STORE_URL=
MOBILE_IOS_STORE_URL=
MOBILE_SUPPORT_PHONE=
MOBILE_SUPPORT_WHATSAPP=
MOBILE_SUPPORT_EMAIL=
# Only "counter" is currently implemented; leave empty to disable booking creation.
MOBILE_PAYMENT_METHODS=
# Use "log" only in local/testing. Production SMS delivery is not implemented.
MOBILE_OTP_DRIVER=disabled
MOBILE_OTP_TTL_MINUTES=10

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

BOOKKARU_API_KEY=
BOOKKARU_USER_EMAIL=bookkaru@kt.com

# Hosted mobile payments. Keep disabled until sandbox acceptance and scheduler setup.
MOBILE_PAYMENT_ENVIRONMENT=sandbox
MOBILE_ONLINE_PAYMENTS_ENABLED=false
MOBILE_PAYMENT_PREVIEW_ONLY=false
MOBILE_CHECKOUT_MINUTES=10
MOBILE_JAZZCASH_MERCHANT_ID=
MOBILE_JAZZCASH_PASSWORD=
MOBILE_JAZZCASH_INTEGRITY_SALT=
MOBILE_JAZZCASH_CHECKOUT_URL=
MOBILE_JAZZCASH_STATUS_URL=
MOBILE_ALFALAH_MERCHANT_ID=
MOBILE_ALFALAH_STORE_ID=
MOBILE_ALFALAH_MERCHANT_HASH=
MOBILE_ALFALAH_USERNAME=
MOBILE_ALFALAH_PASSWORD=
MOBILE_ALFALAH_KEY1=
MOBILE_ALFALAH_KEY2=
MOBILE_ALFALAH_BASE_URL=https://sandbox.bankalfalah.com
